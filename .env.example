# SEC requires a User-Agent containing a real contact email address and returns
# 403 without one. A repo URL alone is not accepted.
SEC_USER_AGENT="ai-ecosystem-dashboard/0.1 (you@example.com)"

# Free from https://artificialanalysis.ai — optional. Without it the benchmark
# fetcher skips cleanly and /models renders from free sources.
ARTIFICIALANALYSIS_API_KEY=""
