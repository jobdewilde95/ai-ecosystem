{
  "name": "ai-ecosystem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:fetch": "tsx scripts/build-snapshot.ts",
    "data:fetch:dry": "tsx scripts/build-snapshot.ts --dry-run",
    "data:derive": "tsx scripts/derive/build-derived.ts",
    "data:seed": "tsx scripts/seed/build-seed.ts",
    "build:offline": "NODE_OPTIONS='--import ./scripts/ci/block-network.mjs' next build"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "zod": "3.25.76"
  }
}
